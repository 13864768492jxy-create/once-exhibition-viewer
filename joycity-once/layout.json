  "poems": [
    {
      "id": "poem-1",
      "text": "我在以后看见他们",
      "position": [
        2.25,
        0.009,
        2.62
      ],
      "rotationY": -30.579227751638417,
      "fontSize": 0.075,
      "width": 1.75,
      "color": "#62685f",
      "surface": "floor",
      "relationship": "沿入口金属斜线，朝第一组背影照片展开。"
    },
    {
      "id": "poem-2",
      "text": "迎着风谈论明天",
      "position": [
        1.4,
        0.009,
        5.77
      ],
      "rotationY": 7,
      "fontSize": 0.065,
      "width": 1.5,
      "color": "#62685f",
      "surface": "floor",
      "relationship": "进入第一片突出墙前。"
    },
    {
      "id": "poem-3",
      "text": "群山还未合拢",
      "runs": [
        {
          "text": "群山",
          "weight": 600,
          "fontScale": 1.25
        },
        {
          "text": "还未合拢",
          "weight": 400,
          "fontScale": 1
        }
      ],
      "position": [
        2.05,
        0.009,
        9.85
      ],
      "rotationY": 0,
      "fontSize": 0.065,
      "width": 1.5,
      "color": "#62685f",
      "surface": "floor",
      "relationship": "与20号山间水面相邻。"
    },
    {
      "id": "poem-4",
      "text": "河流带有未命名的方向，\n从每个人流过。",
      "position": [
        1.58,
        0.009,
        10.7
      ],
      "rotationY": -61.69924548838408,
      "fontSize": 0.065,
      "width": 1.9,
      "lineHeight": 1.5,
      "color": "#576258",
      "surface": "floor",
      "relationship": "顺中段金属线的斜向，靠近21号水面与右侧向后的通道。"
    },
    {
      "id": "poem-5",
      "text": "已经发生的世界",
      "position": [
        1.05,
        0.009,
        17.28
      ],
      "rotationY": 0,
      "fontSize": 0.065,
      "width": 1.7,
      "color": "#62685f",
      "surface": "floor",
      "relationship": "与中墙上的横亘、对面在我与他们之间共同组成一句。"
    },
    {
      "id": "poem-6",
      "text": "横亘",
      "position": [
        1.45,
        0.23,
        17.932
      ],
      "rotationY": 180,
      "fontSize": 0.13,
      "width": 0.8,
      "color": "#5b655c",
      "surface": "wall",
      "relationship": "落在第二片突出墙正面的墙根；整词保留，不拆散笔画。"
    },
    {
      "id": "poem-7",
      "text": "在我与他们之间，",
      "position": [
        4.367,
        0.8,
        19.9
      ],
      "rotationY": -90,
      "fontSize": 0.055,
      "width": 1.6,
      "color": "#606a60",
      "surface": "wall",
      "relationship": "同一句的最后一部分在对面玻璃间隙，引导转身跨看空间。"
    },
    {
      "id": "poem-8",
      "text": "他们再也看不见我",
      "runs": [
        {
          "text": "他们",
          "weight": 700,
          "fontScale": 1
        },
        {
          "text": "再也看不见我",
          "weight": 300,
          "fontScale": 1
        }
      ],
      "position": [
        2.25,
        0.009,
        28.65
      ],
      "rotationY": 0,
      "fontSize": 0.075,
      "width": 1.8,
      "color": "#62685f",
      "surface": "floor",
      "relationship": "回到泳池与影像之间的观看位置。"
    }
  ],
